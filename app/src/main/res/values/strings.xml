    <string name="playlist">Playlist</string>
    <string name="playlist_url">M3U playlist URL</string>
    <string name="playlist_help">Any M3U/M3U8 playlist works. iptv-org also publishes per-country lists, e.g. https://iptv-org.github.io/iptv/countries/us.m3u. The last downloaded list is cached so the app opens instantly.</string>
    <string name="use_my_country">Use my country\'s playlist</string>
    <string name="backup_playlists">Backup playlists (one URL per line)</string>
    <string name="backup_playlists_help">Used only for extra links: when a channel\'s stream fails, the app tries the same channel from these playlists (matched by tvg-id). They don\'t add new channels. Leave empty to turn this off.</string>
